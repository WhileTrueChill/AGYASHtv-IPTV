{
  "name": "agyashtv-desktop",
  "version": "1.0.1",
  "private": true,
  "description": "AGYASHtv IPTV desktop app",
  "main": "main.cjs",
  "scripts": {
    "dist:win": "electron-builder --win nsis --x64"
  },
  "dependencies": {
    "express": "^5.1.0"
  },
  "devDependencies": {
    "electron": "^39.0.0",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "com.agyash.tv.desktop",
    "productName": "AGYASHtv",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.cjs",
      "preload.cjs",
      "package.json",
      "api/**/*",
      "web/**/*",
      "node_modules/**/*"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "AGYASHtv-Setup.exe"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "AGYASHtv"
    }
  }
}